# Database Connection (PostgreSQL)
DATABASE_URI=postgresql://user:password@host:port/database

# REQUIRED in production: the database CA certificate (PEM, inline) so the
# Postgres TLS connection verifies both the server certificate and its issuer.
# Download it from Supabase → Database → SSL. Production startup fails closed
# when this value is missing or is not PEM-formatted.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Payload CMS Secret (REQUIRED in production — no fallback)
PAYLOAD_SECRET=your_payload_secret_key

# Supabase Keys (if used on client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# S3 Compatible Storage Configuration (e.g. Supabase Storage / Cloudflare R2 / AWS S3)
S3_BUCKET=media
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
S3_REGION=eu-central-1
S3_ENDPOINT=https://your-project.supabase.co/storage/v1/s3

# Resend Email Configuration (contact, B2B, checkout, account security)
RESEND_API_KEY=re_your_resend_api_key
# All From addresses must use a domain verified in Resend. These sender aliases
# do not need mailboxes; the monitored Reply-To address below does.
RESEND_FROM_NAME=Ossa Bois France
RESEND_FROM_ADDRESS=info@yourdomain.com
RESEND_ORDER_FROM_ADDRESS=order@yourdomain.com
RESEND_AUTH_FROM_ADDRESS=security@yourdomain.com
# Optional full sender overrides retained for backwards compatibility.
# RESEND_FROM_EMAIL=Ossa Bois France <info@yourdomain.com>
# RESEND_ORDER_FROM_EMAIL=Ossa Bois France <order@yourdomain.com>
# Optional dedicated sender for professional enquiries; defaults to
# Ossa Bois France <b2b@ossaboisfrance.com>.
# RESEND_B2B_FROM_EMAIL=Ossa Bois France <b2b@yourdomain.com>
# Must be a real, monitored inbox. Used when customers or staff reply.
RESEND_REPLY_TO_EMAIL=monitored-inbox@example.com
# Required in production for inbound leads and order notifications.
RESEND_ADMIN_EMAIL=admin@yourdomain.com

# Canonical HTTPS origin used for order assets and absolute password-reset links.
NEXT_PUBLIC_SITE_URL=https://ossaboisfrance.com

# Error monitoring (optional). Sentry stays completely inert until these are set.
# SENTRY_DSN=https://...ingest.sentry.io/...
# NEXT_PUBLIC_SENTRY_DSN=https://...ingest.sentry.io/...

# Durable rate limiting (optional). Without these, an in-memory limiter is used.
# Works with Upstash Redis or Vercel KV (set either pair).
# UPSTASH_REDIS_REST_URL=https://...upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...

# Content-Security-Policy rollout (optional). The CSP is ENFORCING by default.
# Set to "true" to switch to Report-Only mode (reports violations without
# blocking) — useful when adding a new third-party script/origin.
# CSP_REPORT_ONLY=true

# Defense-in-depth for the dev/import/maintenance endpoints (import-*,
# cleanup-*, upload-planimetry). These are always blocked in production. In any
# NON-production environment, if this token is set, the endpoints additionally
# require it via the `x-admin-task-token` header (or ?adminToken=). Leave unset
# for local development convenience.
# ADMIN_TASK_TOKEN=generate_a_long_random_string
